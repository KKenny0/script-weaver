# Script-Weaver Configuration
# Copy this file to .env and fill in your values.

# LLM Provider: anthropic, openai, deepseek, glm, qwen, openai_compatible
SCRIPTWEAVER_LLM_PROVIDER=anthropic
SCRIPTWEAVER_LLM_MODEL=claude-sonnet-4-20250514

# API Keys (set the one matching your provider)
SCRIPTWEAVER_ANTHROPIC_API_KEY=
SCRIPTWEAVER_OPENAI_API_KEY=
SCRIPTWEAVER_DEEPSEEK_API_KEY=
SCRIPTWEAVER_GLM_API_KEY=
SCRIPTWEAVER_QWEN_API_KEY=

# For openai_compatible provider (Ollama, vLLM, etc.)
# SCRIPTWEAVER_OPENAI_BASE_URL=http://localhost:11434/v1

# Optional daemon credential paths. The UI reads the creator token; CLI/MCP read
# the proposal-only agent token. Defaults are kept in the local data directory.
# SCRIPT_WEAVER_TOKEN_FILE=/path/to/runtime.token
# SCRIPT_WEAVER_AGENT_TOKEN_FILE=/path/to/agent.token

# Optional local MiniMax-H3 H3-Base FL2VA endpoint. Use a literal loopback IP;
# the shared root must be mounted at the same absolute path in the H3 process.
# SCRIPT_WEAVER_H3_URL=http://127.0.0.1:30000
# SCRIPT_WEAVER_H3_SHARED_MEDIA_ROOT=/absolute/shared/script-weaver-h3
